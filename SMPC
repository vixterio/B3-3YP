def clinical_glucose_cost(
    glucose_mg_dL: np.ndarray,
    time_min: np.ndarray,
    *,
    w_mean: float,
    w_TIR: float,
    w_TBR: float,
    w_var: float,
    trim_min: float = 200.0,
) -> float:
    """
    Compute a scalar clinical cost J in [0,1] from a glucose time series using:
      - mean glucose penalty
      - time-in-range penalty (70-180)
      - time-below-range penalty (<70)
      - variability penalty (std dev)

    All sub-scores are clamped to [0,1]. Weights are normalized to sum to 1.
    """
    g = np.asarray(glucose_mg_dL, dtype=float).reshape(-1)
    t = np.asarray(time_min, dtype=float).reshape(-1)

    # Basic validation / alignment
    n = min(g.size, t.size)
    if n == 0:
        return 1.0
    g = g[:n]
    t = t[:n]

    # Preprocessing: ignore t < trim_min
    keep = t >= float(trim_min)
    g = g[keep]
    t = t[keep]
    if g.size < 2:
        # Not enough data to compute time fractions or variability
        return 1.0

    # --- Weights: normalize to sum to 1 (robust to bad inputs) ---
    w = np.array([w_mean, w_TIR, w_TBR, w_var], dtype=float)
    w = np.where(np.isfinite(w), w, 0.0)
    w = np.maximum(w, 0.0)
    s = float(w.sum())
    if s <= 0.0:
        w = np.array([0.25, 0.25, 0.25, 0.25], dtype=float)
    else:
        w = w / s
    w_mean, w_TIR, w_TBR, w_var = (float(w[0]), float(w[1]), float(w[2]), float(w[3]))

    # --- Time step weights for fractions (handles nonuniform sampling) ---
    # Use forward differences; last sample gets same dt as the previous to avoid dropping it.
    dt = np.diff(t)
    dt = np.where(np.isfinite(dt), dt, 0.0)
    dt = np.maximum(dt, 0.0)
    if dt.size == 0:
        return 1.0
    dt = np.concatenate([dt, [dt[-1] if dt[-1] > 0 else 1.0]])
    T = float(dt.sum())
    if T <= 0.0:
        return 1.0

    # ============================================================
    # a) Mean glucose penalty (S_mean) in [0,1]
    # ============================================================
    target = 110.0
    deadband = 5.0
    mean_g = float(np.mean(g))
    dev = max(0.0, abs(mean_g - target) - deadband)

    # Normalization assumption:
    # - deviation >= 50 mg/dL beyond deadband is considered "max penalty" (S_mean=1).
    #   That maps mean outside ~[55,165] to full penalty.
    dev_full = 50.0
    S_mean = float(np.clip(dev / dev_full, 0.0, 1.0))

    # ============================================================
    # b) Time in Range penalty (S_TIR) in [0,1]
    # ============================================================
    in_range = (g >= 70.0) & (g <= 180.0)
    tir_frac = float(np.sum(dt[in_range]) / T)
    S_TIR = float(np.clip(1.0 - tir_frac, 0.0, 1.0))

    # ============================================================
    # c) Time Below Range penalty (S_TBR) in [0,1]
    # ============================================================
    below = g < 70.0
    tbr_frac = float(np.sum(dt[below]) / T)
    S_TBR = float(np.clip(tbr_frac, 0.0, 1.0))

    # ============================================================
    # d) Variability penalty (S_var) in [0,1]
    # ============================================================
    # Use standard deviation (mg/dL) and map:
    #   std <= 20 -> 0 penalty
    #   std >= 60 -> 1 penalty
    std_g = float(np.std(g))
    std_lo = 20.0
    std_hi = 60.0
    if std_hi <= std_lo:
        S_var = 1.0
    else:
        S_var = float(np.clip((std_g - std_lo) / (std_hi - std_lo), 0.0, 1.0))

    # Final bounded weighted sum
    J = w_mean * S_mean + w_TIR * S_TIR + w_TBR * S_TBR + w_var * S_var
    return float(np.clip(J, 0.0, 1.0))


